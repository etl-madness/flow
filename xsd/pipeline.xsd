<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ROOT ELEMENT -->
    <xs:element name="pipeline">
        <xs:annotation>
            <xs:documentation>Root element for an ETL data pipeline orchestration definition[cite:
                1, 8]. Encapsulates global variables, database handles, preflight validations, and
                execution flow nodes[cite: 1, 8].</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="variables" type="VariablesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Container for initial pipeline environment variable
                            declarations[cite: 1, 8].</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="databases" type="DatabasesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Container for database connection configurations,
                            connection pooling, and workload profile setup[cite: 1, 8].</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="preflight" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Preflight execution block containing validation and
                            initialization tasks run prior to the main flow[cite: 1, 8].</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="flow" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>Main execution block containing the primary sequential,
                            conditional, parallel, or iterative pipeline steps[cite: 1, 8].</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="description" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation>Human-readable summary or metadata description of the
                        pipeline[cite: 8].</xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- VARIABLE DEFINITIONS -->
    <xs:complexType name="VariablesType">
        <xs:annotation>
            <xs:documentation>Defines a collection of dynamic pipeline environment variables[cite:
                1, 8].</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="variable" type="VariableType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>An individual variable declaration with type parsing[cite: 1,
                        8].</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the variables section[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="VariableType">
        <xs:annotation>
            <xs:documentation>Initializes a named pipeline variable with explicit type
                conversion[cite: 1, 5, 8].</xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Optional unique identifier for the variable definition[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Variable identifier used for interpolation (e.g., {{VarName}}) or
                    environment lookup[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="type" use="optional" default="string">
            <xs:annotation>
                <xs:documentation>Data type for parsing (defaults to string)[cite: 1, 8]. Converts
                    raw strings to int, bool, float, or datetime values[cite: 1, 5, 8].</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="string" />
                    <xs:enumeration value="int" />
                    <xs:enumeration value="integer" />
                    <xs:enumeration value="bool" />
                    <xs:enumeration value="boolean" />
                    <xs:enumeration value="float" />
                    <xs:enumeration value="double" />
                    <xs:enumeration value="float64" />
                    <xs:enumeration value="datetime" />
                    <xs:enumeration value="date" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Initial scalar string value assigned to the variable[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the variable's usage or source[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- DATABASE DEFINITIONS -->
    <xs:complexType name="DatabasesType">
        <xs:annotation>
            <xs:documentation>Container for relational and key-value database connection
                handles[cite: 1, 8].</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="database" type="DatabaseType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Individual database target definition[cite: 1, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the database connection block[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="DatabaseType">
        <xs:annotation>
            <xs:documentation>Configures relational (e.g., SQL Server, PostgreSQL, MySQL, SQLite,
                Oracle) or embedded Key-Value handles (e.g., bbolt, BadgerDB)[cite: 1, 5, 8].</xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Optional internal identifier for the database item[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Unique alias name referenced by pipeline execution nodes[cite: 1,
                    8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="driver" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Driver protocol (e.g., postgres, mysql, sqlite, sqlserver, oracle,
                    bbolt, badger, redis, etcd)[cite: 1, 5, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="type" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for driver[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="connection_string" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>DSN, connection string, or embedded DB file path. Supports
                    {{VarName}} interpolation[cite: 1, 5, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="max_open_conns" type="xs:positiveInteger" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum concurrent open connections in the pool (defaults to
                    25)[cite: 1, 5, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="max_idle_conns" type="xs:positiveInteger" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum idle connections retained in the pool (defaults to
                    10)[cite: 1, 5, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="conn_max_lifetime_seconds" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Maximum duration a connection is recycled (e.g., 5m or 300)[cite:
                    1, 5, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="workload" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Workload profile metadata for driver tuning (e.g., oltp, bulk,
                    analytics)[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="description" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Description of the database target[cite: 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- RECURSIVE NODE CONTAINER -->
    <xs:complexType name="PipelineNodesType">
        <xs:annotation>
            <xs:documentation>Polymorphic sequence container holding executable pipeline AST
                steps[cite: 1, 8].</xs:documentation>
        </xs:annotation>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="script" type="ScriptType">
                <xs:annotation>
                    <xs:documentation>Executes code in Go (Yaegi), Shell (Bash, PowerShell, Cmd), or
                        .NET Script (CSX)[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sql" type="SqlType">
                <xs:annotation>
                    <xs:documentation>Executes SQL statements, DDL, DML, or queries on a registered
                        database[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sql_bulk" type="SqlBulkType">
                <xs:annotation>
                    <xs:documentation>Performs high-performance bulk streaming copy between query
                        sources and database target tables[cite: 1, 2, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="kv" type="KVType">
                <xs:annotation>
                    <xs:documentation>Executes single Key-Value store operations (GET, PUT, DELETE,
                        SCAN) on embedded or server KV stores.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="kv_bulk" type="KVBulkType">
                <xs:annotation>
                    <xs:documentation>Streams bulk datasets between SQL source queries and Key-Value
                        database buckets/namespaces.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="group" type="GroupType">
                <xs:annotation>
                    <xs:documentation>Groups child steps sequentially with optional conditional
                        evaluation and transaction wrapping[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="parallel" type="ParallelType">
                <xs:annotation>
                    <xs:documentation>Executes child steps concurrently across worker threads with
                        isolated scopes[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="if" type="IfType">
                <xs:annotation>
                    <xs:documentation>Conditional branching block evaluating pipeline variables or
                        expressions[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="foreach" type="ForEachType">
                <xs:annotation>
                    <xs:documentation>Iterates over rows returned by a SQL query driver, binding
                        columns as loop variables[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="loop" type="ForEachType">
                <xs:annotation>
                    <xs:documentation>Alias for foreach[cite: 1, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="while" type="WhileType">
                <xs:annotation>
                    <xs:documentation>Repeats execution of child steps while a variable condition
                        evaluates to true[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="http_client" type="HttpClientType">
                <xs:annotation>
                    <xs:documentation>Dispatches HTTP requests and captures response bodies and
                        status codes[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="template" type="TemplateType">
                <xs:annotation>
                    <xs:documentation>Renders Go text/template templates using current variable
                        context[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="template_html" type="TemplateHtmlType">
                <xs:annotation>
                    <xs:documentation>Renders Go html/template templates with contextual HTML
                        escaping[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="file_save" type="FileSaveType">
                <xs:annotation>
                    <xs:documentation>Writes string payload or variable contents to disk[cite: 1, 3,
                        8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="file_read" type="FileReadType">
                <xs:annotation>
                    <xs:documentation>Reads raw file content from disk into a target pipeline
                        variable[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excel_read" type="ExcelReadType">
                <xs:annotation>
                    <xs:documentation>Reads an Excel worksheet and converts rows into a JSON array
                        variable[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="excel_write" type="ExcelWriteType">
                <xs:annotation>
                    <xs:documentation>Executes a database query and writes result sets directly into
                        an Excel worksheet[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="xml_xpath" type="XmlXPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates XPath expressions against XML files or variable
                        sources[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="json_path" type="JsonPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates JSONPath expressions against JSON files or variable
                        sources[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="yaml_path" type="YamlPathType">
                <xs:annotation>
                    <xs:documentation>Evaluates path queries against YAML files or variable
                        sources[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="assert" type="AssertType">
                <xs:annotation>
                    <xs:documentation>Validates pipeline conditions and controls flow continuation,
                        warning, or fallback branches[cite: 1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:choice>
    </xs:complexType>

    <!-- KEY-VALUE SINGLE NODE -->
    <xs:complexType name="KVType">
        <xs:annotation>
            <xs:documentation>Executes atomic Key-Value database operations (GET, PUT, DELETE, SCAN)
                against target KV stores.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique step identifier for execution tracking.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="db" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>Registered Key-Value database connection name.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="database" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for db.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="bucket" type="xs:string" use="optional" default="default">
                    <xs:annotation>
                        <xs:documentation>Bucket name (bbolt/BadgerDB) or key prefix/namespace
                            (Redis/etcd). Defaults to 'default'.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="op" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>KV operation type: get, put, set, delete, del, or scan.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="operation" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for op.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="key" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Target record key string. Supports {{VarName}}
                            interpolation.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="value" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Target record value payload for put/set operations.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="val" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for value.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Input variable containing dynamic command DSL text.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable name that stores retrieved values or execution
                            output.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="out_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for output_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the KV step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- KEY-VALUE BULK STREAMING NODE -->
    <xs:complexType name="KVBulkType">
        <xs:annotation>
            <xs:documentation>Streams bulk record sets between relational SQL databases and
                Key-Value stores.</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique step identifier for execution tracking.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="db" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>Source database handle executing the extraction query.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="database" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for db.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="target_db" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Destination Key-Value database handle (defaults to source
                            db if omitted).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="target_database" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for target_db.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="bucket" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Source bucket/namespace identifier.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="target_bucket" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Destination bucket/namespace receiving streamed key/value
                            pairs.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="batch_size" type="xs:positiveInteger" use="optional"
                    default="10000">
                    <xs:annotation>
                        <xs:documentation>Number of key-value records per transactional flush
                            (defaults to 10,000).</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable containing the source extraction SQL query
                            string.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="variable" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="output_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Variable that receives the count of written records.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="out_var" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Alias for output_var.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="description" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Description of the KV bulk streaming step.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- ASSERT NODE -->
    <xs:element name="assert" type="AssertType">
        <xs:annotation>
            <xs:documentation>Asserts variable state and defines fallback behavior on condition
                failure[cite: 1, 3, 8].</xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:complexType name="AssertType">
        <xs:annotation>
            <xs:documentation>Evaluates conditions against variables with halt, warn, continue, or
                on_failure fallback blocks[cite: 1, 3, 8].</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="on_failure" type="PipelineNodesType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Child nodes executed when the assertion condition fails[cite:
                        1, 3, 8].</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Unique step identifier[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="var" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Variable name or expression evaluated for condition checking[cite:
                    1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="equals" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Expected string value required to pass assertion[cite: 1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Alias for equals[cite: 1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="operator" type="xs:string" use="optional" default="eq">
            <xs:annotation>
                <xs:documentation>Comparison operator (e.g., eq, ==, ne, !=)[cite: 1, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="message" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Message emitted when assertion fails[cite: 1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="on_failure" type="xs:string" use="optional" default="halt">
            <xs:annotation>
                <xs:documentation>Action on failure: halt (stops pipeline execution), warn/continue
                    (logs and continues), or set_var[cite: 1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="fail_var" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Variable set when assertion fails[cite: 1, 3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="fail_val" type="xs:string" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>Value assigned to fail_var on failure (defaults to true)[cite: 1,
                    3, 8].</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- SCRIPT NODE -->
    <xs:complexType name="ScriptType">
        <xs:annotation>
            <xs:documentation>Executes dynamic code in Go, Shell, PowerShell, Bash, or .NET Script
                (CSX)[cite: 1, 3, 8].</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>Unique step identifier[cite: 1, 8].</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="language" use="optional">
                    <xs:annotation>
                        <xs:documentation>Script runtime (e.g., go, shell, cmd, powershell, pwsh,
                            bash, zsh, dotnet-script, csx)[cite: 1, 3, 8].</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="go" />
                            <xs:enumeration value="shell" />
                            <xs:enumeration value="cmd" />
                            <xs:enumeration value="powershell" />
                            <xs:enumeration value="pwsh" />
                            <xs:enumeration value="bash" />
                            <xs:enumeration value="git-bash" />
                            <xs:enumeration value="gitbash" />
                            <xs:enumeration value="zsh" />
                            <xs:enumeration value="ksh" />
                            <xs:enumeration value="csh" />
                            <xs:enumeration value="tcsh" />
                            <xs:enumeration value="dash" />
                            <xs:enumeration value="fish" />
                            <xs:enumeration value="sh" />
                            <xs:enumeration value="dotnet-script" />
                            <xs:enumeration value="csx" />
                        </xs:restriction>
