<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ROOT ELEMENT -->
    <xs:element name="pipeline">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="variables" type="VariablesType" minOccurs="0" maxOccurs="1" />
                <xs:element name="databases" type="DatabasesType" minOccurs="0" maxOccurs="1" />
                <xs:element name="scripts" type="PipelineNodesType" minOccurs="0" maxOccurs="1" />
            </xs:sequence>
            <xs:attribute name="description" type="xs:string" use="optional" />
        </xs:complexType>
    </xs:element>

    <!-- VARIABLE DEFINITIONS -->
    <xs:complexType name="VariablesType">
        <xs:sequence>
            <xs:element name="variable" type="VariableType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="VariableType">
        <xs:attribute name="id" type="xs:string" use="optional" />
        <xs:attribute name="name" type="xs:string" use="required" />
        <xs:attribute name="type" use="optional" default="string">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="string" />
                    <xs:enumeration value="int" />
                    <xs:enumeration value="integer" />
                    <xs:enumeration value="bool" />
                    <xs:enumeration value="boolean" />
                    <xs:enumeration value="float" />
                    <xs:enumeration value="double" />
                    <xs:enumeration value="float64" />
                    <xs:enumeration value="datetime" />
                    <xs:enumeration value="date" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="value" type="xs:string" use="required" />
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <!-- DATABASE DEFINITIONS -->
    <xs:complexType name="DatabasesType">
        <xs:sequence>
            <xs:element name="database" type="DatabaseType" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="DatabaseType">
        <xs:attribute name="id" type="xs:string" use="optional" />
        <xs:attribute name="name" type="xs:string" use="required" />
        <xs:attribute name="driver" type="xs:string" use="optional" />
        <xs:attribute name="type" type="xs:string" use="optional" />
        <xs:attribute name="connection_string" type="xs:string" use="required" />
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <!-- RECURSIVE NODE CONTAINER -->
    <xs:complexType name="PipelineNodesType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="script" type="ScriptType" />
            <xs:element name="group" type="GroupType" />
            <xs:element name="parallel" type="ParallelType" />
            <xs:element name="if" type="IfType" />
            <xs:element name="foreach" type="ForEachType" />
            <xs:element name="loop" type="ForEachType" />
            <xs:element name="while" type="WhileType" />
            <xs:element name="http_client" type="HttpClientType" />
            <xs:element name="http-client" type="HttpClientType" />
            <xs:element name="HTTP_CLIENT" type="HttpClientType" />
            <xs:element name="template" type="TemplateType" />
            <xs:element name="file_save" type="FileSaveType" />
            <xs:element name="file-save" type="FileSaveType" />
            <xs:element name="FILE_SAVE" type="FileSaveType" />
            <xs:element name="file_read" type="FileReadType" />
            <xs:element name="file-read" type="FileReadType" />
            <xs:element name="FILE_READ" type="FileReadType" />
            <xs:element name="excel_read" type="ExcelReadType" />
            <xs:element name="excel-read" type="ExcelReadType" />
            <xs:element name="EXCEL_READ" type="ExcelReadType" />
            <xs:element name="excel_write" type="ExcelWriteType" />
            <xs:element name="excel-write" type="ExcelWriteType" />
            <xs:element name="EXCEL_WRITE" type="ExcelWriteType" />
            <xs:element name="xml_xpath" type="XmlXPathType" />
            <xs:element name="xml-xpath" type="XmlXPathType" />
            <xs:element name="XML_XPATH" type="XmlXPathType" />
            <xs:element name="json_path" type="JsonPathType" />
            <xs:element name="json-path" type="JsonPathType" />
            <xs:element name="JSON_PATH" type="JsonPathType" />
            <xs:element name="yaml_path" type="YamlPathType" />
            <xs:element name="yaml-path" type="YamlPathType" />
            <xs:element name="YAML_PATH" type="YamlPathType" />
        </xs:choice>
    </xs:complexType>

    <!-- SCRIPT NODE -->
    <xs:complexType name="ScriptType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="language" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="sql" />
                            <xs:enumeration value="go" />
                            <xs:enumeration value="shell" />
                            <xs:enumeration value="cmd" />
                            <xs:enumeration value="powershell" />
                            <xs:enumeration value="pwsh" />
                            <xs:enumeration value="bash" />
                            <xs:enumeration value="git-bash" />
                            <xs:enumeration value="gitbash" />
                            <xs:enumeration value="zsh" />
                            <xs:enumeration value="ksh" />
                            <xs:enumeration value="csh" />
                            <xs:enumeration value="tcsh" />
                            <xs:enumeration value="dash" />
                            <xs:enumeration value="fish" />
                            <xs:enumeration value="sh" />
                            <xs:enumeration value="dotnet-script" />
                            <xs:enumeration value="csx" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="lang" type="xs:string" use="optional" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="database" type="xs:string" use="optional" />
                <xs:attribute name="target_db" type="xs:string" use="optional" />
                <xs:attribute name="target_database" type="xs:string" use="optional" />
                <xs:attribute name="target_table" type="xs:string" use="optional" />
                <xs:attribute name="batch_size" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="output_variable" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />
                <xs:attribute name="tablock" type="xs:boolean" use="optional" />
                <xs:attribute name="check_constraints" type="xs:boolean" use="optional" />
                <xs:attribute name="fire_triggers" type="xs:boolean" use="optional" />
                <xs:attribute name="keep_nulls" type="xs:boolean" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- HTTP CLIENT NODE -->
    <xs:complexType name="HttpClientType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <!-- Core Request Attributes -->
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="uri" type="xs:string" use="required" />
                <xs:attribute name="url" type="xs:string" use="optional" />
                <xs:attribute name="method" use="optional" default="GET">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="GET" />
                            <xs:enumeration value="POST" />
                            <xs:enumeration value="PUT" />
                            <xs:enumeration value="DELETE" />
                            <xs:enumeration value="PATCH" />
                            <xs:enumeration value="HEAD" />
                            <xs:enumeration value="OPTIONS" />
                            <xs:enumeration value="TRACE" />
                            <xs:enumeration value="CONNECT" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="data" type="xs:string" use="optional" />
                <xs:attribute name="headers" type="xs:string" use="optional" />
                <xs:attribute name="content_type" type="xs:string" use="optional" />

                <!-- Variable Assignment Attributes -->
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="output_variable" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />

                <!-- Status Code Assignment Attributes -->
                <xs:attribute name="status_code_var" type="xs:string" use="optional" />
                <xs:attribute name="status_code_variable" type="xs:string" use="optional" />
                <xs:attribute name="status_var" type="xs:string" use="optional" />
                <xs:attribute name="status_variable" type="xs:string" use="optional" />

                <!-- Go http.Client Options -->
                <xs:attribute name="timeout" type="xs:string" use="optional" />
                <xs:attribute name="max_redirects" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="follow_redirects" type="xs:boolean" use="optional" default="true" />
                <xs:attribute name="cookie_jar" type="xs:boolean" use="optional" default="false" />

                <!-- Go http.Transport Options -->
                <xs:attribute name="proxy" type="xs:string" use="optional" />
                <xs:attribute name="tls_insecure_skip_verify" type="xs:boolean" use="optional" default="false" />
                <xs:attribute name="tls_handshake_timeout" type="xs:string" use="optional" />
                <xs:attribute name="tls_server_name" type="xs:string" use="optional" />
                <xs:attribute name="tls_min_version" type="xs:string" use="optional" />
                <xs:attribute name="tls_max_version" type="xs:string" use="optional" />
                <xs:attribute name="disable_keep_alives" type="xs:boolean" use="optional" />
                <xs:attribute name="disable_compression" type="xs:boolean" use="optional" />
                <xs:attribute name="max_idle_conns" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="max_idle_conns_per_host" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="max_conns_per_host" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="idle_conn_timeout" type="xs:string" use="optional" />
                <xs:attribute name="response_header_timeout" type="xs:string" use="optional" />
                <xs:attribute name="expect_continue_timeout" type="xs:string" use="optional" />
                <xs:attribute name="max_response_header_bytes" type="xs:long" use="optional" />
                <xs:attribute name="write_buffer_size" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="read_buffer_size" type="xs:nonNegativeInteger" use="optional" />
                <xs:attribute name="force_attempt_http2" type="xs:boolean" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- GROUP NODE -->
    <xs:complexType name="GroupType">
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="if_var" type="xs:string" use="optional" />
                <xs:attribute name="equals" type="xs:string" use="optional" />
                <xs:attribute name="val" type="xs:string" use="optional" />
                <xs:attribute name="value" type="xs:string" use="optional" />
                <xs:attribute name="if_val" type="xs:string" use="optional" />
                <xs:attribute name="if_equals" type="xs:string" use="optional" />
                <xs:attribute name="condition" type="xs:string" use="optional" />
                <xs:attribute name="cond" type="xs:string" use="optional" />
                <xs:attribute name="transaction" type="xs:boolean" use="optional" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="database" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- PARALLEL NODE -->
    <xs:complexType name="ParallelType">
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="max_threads" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="threads" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="concurrency" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- IF / CONDITIONAL NODE -->
    <xs:complexType name="IfType">
        <xs:sequence>
            <xs:element name="then" type="PipelineNodesType" minOccurs="0" maxOccurs="1" />
            <xs:element name="else" type="PipelineNodesType" minOccurs="0" maxOccurs="1" />
            <!-- Allows inline children without explicit <then> tags -->
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="script" type="ScriptType" />
                <xs:element name="group" type="GroupType" />
                <xs:element name="parallel" type="ParallelType" />
                <xs:element name="if" type="IfType" />
                <xs:element name="foreach" type="ForEachType" />
                <xs:element name="loop" type="ForEachType" />
                <xs:element name="while" type="WhileType" />
                <xs:element name="http_client" type="HttpClientType" />
                <xs:element name="http-client" type="HttpClientType" />
                <xs:element name="HTTP_CLIENT" type="HttpClientType" />
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="optional" />
        <xs:attribute name="var" type="xs:string" use="optional" />
        <xs:attribute name="if_var" type="xs:string" use="optional" />
        <xs:attribute name="equals" type="xs:string" use="optional" />
        <xs:attribute name="val" type="xs:string" use="optional" />
        <xs:attribute name="value" type="xs:string" use="optional" />
        <xs:attribute name="if_val" type="xs:string" use="optional" />
        <xs:attribute name="if_equals" type="xs:string" use="optional" />
        <xs:attribute name="condition" type="xs:string" use="optional" />
        <xs:attribute name="cond" type="xs:string" use="optional" />
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <!-- FOREACH / LOOP NODE -->
    <xs:complexType name="ForEachType">
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="language" type="xs:string" use="optional" />
                <xs:attribute name="lang" type="xs:string" use="optional" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="database" type="xs:string" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- WHILE LOOP NODE -->
    <xs:complexType name="WhileType">
        <xs:complexContent>
            <xs:extension base="PipelineNodesType">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="if_var" type="xs:string" use="optional" />
                <xs:attribute name="equals" type="xs:string" use="optional" />
                <xs:attribute name="val" type="xs:string" use="optional" />
                <xs:attribute name="value" type="xs:string" use="optional" />
                <xs:attribute name="if_val" type="xs:string" use="optional" />
                <xs:attribute name="if_equals" type="xs:string" use="optional" />
                <xs:attribute name="condition" type="xs:string" use="optional" />
                <xs:attribute name="cond" type="xs:string" use="optional" />
                <xs:attribute name="max_iterations" type="xs:positiveInteger" use="optional" default="1000" />
                <xs:attribute name="max_loops" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- TEMPLATE NODE -->
    <xs:complexType name="TemplateType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="name" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="optional" />
                <xs:attribute name="engine" type="xs:string" use="optional" default="text" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- FILE SAVE NODE -->
    <xs:complexType name="FileSaveType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="optional" />
                <xs:attribute name="path" type="xs:string" use="optional" />
                <xs:attribute name="filename" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="append" type="xs:boolean" use="optional" default="false" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- FILE READ NODE -->
    <xs:complexType name="FileReadType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="optional" />
                <xs:attribute name="path" type="xs:string" use="optional" />
                <xs:attribute name="filename" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="output_variable" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- EXCEL READ/WRITE NODES -->
    <xs:complexType name="ExcelReadType">
        <xs:attribute name="id" type="xs:string" use="optional" />
        <xs:attribute name="file" type="xs:string" use="required" />
        <xs:attribute name="sheet" type="xs:string" use="optional" default="Sheet1" />
        <xs:attribute name="header" type="xs:boolean" use="optional" default="true" />
        <xs:attribute name="var" type="xs:string" use="optional" />
        <xs:attribute name="output_var" type="xs:string" use="optional" />
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <xs:complexType name="ExcelWriteType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="required" />
                <xs:attribute name="sheet" type="xs:string" use="optional" default="Sheet1" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- XML XPATH NODE -->
    <xs:complexType name="XmlXPathType">
        <xs:attribute name="id" type="xs:string" use="optional" />
        <xs:attribute name="file" type="xs:string" use="optional" />
        <xs:attribute name="var" type="xs:string" use="optional" />
        <xs:attribute name="xpath" type="xs:string" use="required" />
        <xs:attribute name="mode" type="xs:string" use="optional" default="text" />
        <xs:attribute name="output_var" type="xs:string" use="required" />
        <xs:attribute name="description" type="xs:string" use="optional" />
    </xs:complexType>

    <!-- JSON PATH NODE -->
    <xs:complexType name="JsonPathType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="path" type="xs:string" use="optional" />
                <xs:attribute name="jsonpath" type="xs:string" use="optional" />
                <xs:attribute name="mode" type="xs:string" use="optional" default="value" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- YAML PATH NODE -->
    <xs:complexType name="YamlPathType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="file" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="path" type="xs:string" use="optional" />
                <xs:attribute name="yamlpath" type="xs:string" use="optional" />
                <xs:attribute name="mode" type="xs:string" use="optional" default="value" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Add to <xs:complexType name="PipelineNodesType"><xs:choice> -->
    <xs:element name="sql" type="SqlType" />
    <xs:element name="sql_bulk" type="SqlBulkType" />
    <xs:element name="sql-bulk" type="SqlBulkType" />
    <xs:element name="SQL_BULK" type="SqlBulkType" />

    <!-- Add element definitions -->
    <xs:complexType name="SqlType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="database" type="xs:string" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="variable" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="out_var" type="xs:string" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="SqlBulkType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="optional" />
                <xs:attribute name="db" type="xs:string" use="optional" />
                <xs:attribute name="database" type="xs:string" use="optional" />
                <xs:attribute name="target_db" type="xs:string" use="optional" />
                <xs:attribute name="target_database" type="xs:string" use="optional" />
                <xs:attribute name="target_table" type="xs:string" use="required" />
                <xs:attribute name="batch_size" type="xs:positiveInteger" use="optional" />
                <xs:attribute name="var" type="xs:string" use="optional" />
                <xs:attribute name="output_var" type="xs:string" use="optional" />
                <xs:attribute name="tablock" type="xs:boolean" use="optional" />
                <xs:attribute name="check_constraints" type="xs:boolean" use="optional" />
                <xs:attribute name="fire_triggers" type="xs:boolean" use="optional" />
                <xs:attribute name="keep_nulls" type="xs:boolean" use="optional" />
                <xs:attribute name="description" type="xs:string" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
</xs:schema>